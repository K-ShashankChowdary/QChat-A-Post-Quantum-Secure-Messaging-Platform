# Copy this file to .env and fill in real values. Never commit the actual .env file.

# Port the Express/Socket.io server listens on
PORT=5000

# Secret used to sign JWTs — set a long random value, do not use the repo default
JWT_SECRET=change-me-to-a-long-random-secret

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/qchat

# Origin allowed to hit the API / connect over Socket.io (see improve.txt -> OPS-2)
CORS_ORIGIN=http://localhost:5173
