# Copy to .env.local for a non-default setup. All of these are optional in local
# dev: an empty VITE_API_URL routes /api through the Vite proxy in vite.config.js.

# Base URL for the REST API (leave empty to use the dev proxy)
VITE_API_URL=

# Base URL for the Socket.io connection
VITE_SOCKET_URL=http://localhost:5000

# ── WebRTC ICE configuration ──
# STUN alone cannot relay media. Two peers behind symmetric NATs or strict
# firewalls need a TURN server, which is the usual reason a call rings but never
# connects. Leave TURN blank on a single LAN; set it before demoing across
# networks. Comma-separate multiple URLs.
VITE_STUN_URLS=stun:stun.l.google.com:19302
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
