# Copy to .env.local for a non-default setup. Both are optional in local dev:
# an empty VITE_API_URL routes /api through the Vite proxy in vite.config.js.

# Base URL for the REST API (leave empty to use the dev proxy)
VITE_API_URL=

# Base URL for the Socket.io connection
VITE_SOCKET_URL=http://localhost:5000
